# Local services work without per-call APIs; optional cloud credentials are listed below.
DATA_DIR=/data
FFMPEG_THREADS=2
MAX_UPLOAD_MB=250
KOKORO_URL=http://cryptid-kokoro:8880
OLLAMA_URL=http://cryptid-ollama:11434
WHISPER_URL=http://cryptid-whisper:8000
COMFY_URL=http://cryptid-comfyui:8188
COMFY_CHECKPOINT=v1-5-pruned-emaonly.safetensors
COMFY_WORKFLOW=/opt/cryptid/workflows/sd15.json
# Create a free personal token at https://huggingface.co/settings/tokens.
# Cloud inference has provider quotas and sends prompt/text to Hugging Face.
HF_TOKEN=
HF_API_URL=https://router.huggingface.co/hf-inference/models
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_TTS_MODEL=facebook/mms-tts-ita
# Gemini Developer API TTS. The key stays server-side and is never sent to the browser.
GOOGLE_GEMINI_TTS_KEY=
GOOGLE_GEMINI_TTS_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GOOGLE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Google Cloud Text-to-Speech / Chirp 3 HD. Enable billing and the Cloud TTS API.
# Put the service-account JSON in data/google-cloud-tts-credentials.json.
GOOGLE_APPLICATION_CREDENTIALS=/data/google-cloud-tts-credentials.json
GOOGLE_CLOUD_TTS_PROJECT=
GOOGLE_CLOUD_TTS_API_URL=https://texttospeech.googleapis.com/v1/text:synthesize
# Cloudflare Workers AI image generation. Create a scoped token in the Workers AI dashboard.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_API_URL=https://api.cloudflare.com/client/v4/accounts
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
